<?xml version="1.0" encoding="utf-8"?>
<!--
  Template for packaging the standalone app as MSIX for the Microsoft Store.
  Build the Store flavour first (no self-updater):   cargo build --release --features store
  Replace every value marked TODO with the identity Partner Center assigns to your app.
  See README.md > "Publishing to the Microsoft Store".
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="TODO.PartnerCenterIdentityName"
            Publisher="CN=TODO-Partner-Center-Publisher-ID"
            Version="0.1.0.0"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>GPS Route Simulator</DisplayName>
    <PublisherDisplayName>TODO Publisher name</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Simulate GPS routes on your own iPhone over USB for testing location-based apps.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="location-spoofer.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="GPS Route Simulator"
                          Description="Simulate GPS routes on your own iPhone over USB"
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
    <!-- "My real location" shows this PC's position on the map (precise location when Windows allows it). -->
    <DeviceCapability Name="location" />
  </Capabilities>
</Package>
